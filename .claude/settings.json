{
  "permissions": {
    "deny": [],
    "allow": [
      "Bash(xargs cat)",
      "Bash(python3 -c ' *)",
      "Bash(gh auth *)",
      "Bash(git ls-tree *)",
      "Edit(/.claude/commands/connect-related-articles.md)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude_hooks/send_prompt_notification.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude_hooks/send_response_summary.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/claude_hooks/session_progress.py show --hook 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
